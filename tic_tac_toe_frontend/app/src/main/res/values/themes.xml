<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using MaterialComponents Light -->
    <style name="Theme.TicTacToe" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorError">@color/colorError</item>

        <!-- Surfaces and backgrounds -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- Ripple/interactive feedback (use secondary as ripple color reference) -->
        <item name="colorControlHighlight">@color/colorSecondary</item>
    </style>
</resources>
